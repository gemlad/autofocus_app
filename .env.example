# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored - never commit it.

# Todoist personal API token:
# Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=

# Optional: Todoist filter query selecting the tasks AutoFocus should pull in,
# e.g. "#Autofocus" or "today | overdue". Leave blank for all active tasks.
TODOIST_FILTER=
